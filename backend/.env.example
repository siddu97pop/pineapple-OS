PORT=3456
SESSIONS_MD_PATH=/data/obsidian/logs/sessions.md
CLAUDE_MD_PATH=/data/obsidian/CLAUDE.md
SYNCTHING_API_KEY=your_syncthing_api_key_here
SYNCTHING_URL=http://localhost:8384
ALLOWED_ORIGINS=https://pineapple.lexitools.tech
MAX_PTY_SESSIONS=5
# Put each terminal shell and its descendants in a separate systemd scope on Linux.
PTY_SCOPE_ENABLED=true
PTY_MEMORY_MAX=1G
PTY_TASKS_MAX=256
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Comma-separated allowlist of emails permitted to authenticate (fail-closed: empty = nobody allowed)
ALLOWED_USER_EMAILS=siddu97pop@gmail.com

# Semantic vault search (vectorIngest.ts). Server-side only — the service-role key
# bypasses RLS, and public.vault_chunks has RLS on with no policies by design.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Required by POST /api/vault/ask (Phase 4 generation). Stripped from PTY
# environments by ptyEnv.ts's _API_KEY pattern.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
